@model Lr6.Models.OrderViewModel

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Замовлення піци</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <h2>Замовлення піци</h2>
        <form asp-action="Order" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PizzaCount">Скільки найсмачніших піц ви бажаєте замовити?</label>
                <input asp-for="PizzaCount" class="form-control" />
                <span asp-validation-for="PizzaCount" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Підтвердити</button>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>